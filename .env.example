# Copy this file to .env. Never commit the real .env file.
FARMGUARD_API_KEY=replace-with-a-private-key

MQTT_HOST=
MQTT_PORT=8883
MQTT_TOPIC=farmguard/sensors
MQTT_STATUS_TOPIC=farmguard/status
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_TLS=true
# Local broker fallback example:
# MQTT_HOST=127.0.0.1
# MQTT_PORT=1883
# MQTT_TLS=false

DB_HOST=192.168.98.50
DB_PORT=3306
DB_NAME="your_database_name"
DB_USER="your_database_user"
DB_PASSWORD="replace-with-your-database-password"

PORT=7862
